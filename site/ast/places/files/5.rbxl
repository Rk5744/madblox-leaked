				<Item class="LocalScript" referent="RBX1073">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">bin = script.Parent
function onKeyDown(key,mouse) 
key:lower() 
if key == &quot;B&quot; then 
e = game.Workspace:GetChildren()
for i=1,#e do
if e[i].className == &quot;Part&quot; then
if e[i].Name == &quot;Balloon&quot; then  
if e[i]:findFirstChild(&quot;creator&quot;)~=nil then
if e[i].creator.Value == script.Parent.Parent.Parent then
e[i]:remove()
end
end
end
end
end
elseif key == &quot;n&quot; then
e = game.Workspace:GetChildren()
for i=1,#e do
if e[i].className == &quot;Part&quot; then
if e[i].Name == &quot;Balloon&quot; then
e[i]:remove()
end
end
end

end
end

function press(mouse)
if sel == true then
hit = mouse.Target
local point = mouse.Hit.p
s = Instance.new(&quot;Part&quot;)
s.CanCollide = true   
s.Size=Vector3.new(6,6,6)
s.Anchored = true      
s.BrickColor = BrickColor.new(21) 
s.Shape = &quot;Ball&quot;    
s.Name = &quot;Balloon&quot;
s.TopSurface = &quot;Smooth&quot;
s.BottomSurface = &quot;Smooth&quot;
s.Material = &quot;Wood&quot;
