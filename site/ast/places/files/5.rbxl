					<Item class="Script" referent="RBX3092">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Attack</string>
							<ProtectedString name="Source">high = script.Parent.Torso.Position + Vector3.new(0, 8, 0)
defaultp = script.Parent.Torso.Position
defaultc = script.Parent.Torso.CFrame

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 50
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

function findNearestTorsoB(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 35
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

function findNearestTorsoC(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 25
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

while true do
wait()
local target = findNearestTorso(script.Parent.Torso.Position)
local targetB = findNearestTorsoB(script.Parent.Torso.Position)
local targetC = findNearestTorsoC(script.Parent.Torso.Position)
if target ~= nil and targetB == nil and targetC == nil then
script.Parent.RandomMove.Value = false
script.Parent.Target.Value = target
script.Parent.Torso.BodyPosition.position = Vector3.new(script.Parent.Torso.BodyPosition.position.x, high.y, script.Parent.Torso.BodyPosition.position.z)
elseif target ~= nil and targetB ~= nil and targetC == nil then
script.Parent.RandomMove.Value = false
script.Parent.Target.Value = target
script.Parent.Torso.BodyPosition.position = Vector3.new(script.Parent.Torso.BodyPosition.position.x, high.y, script.Parent.Torso.BodyPosition.position.z)
script.Parent.Torso.BodyGyro.cframe = CFrame.new(script.Parent.Torso.Position, targetB.Position) * CFrame.fromEulerAnglesXYZ(0, math.pi, 0)
elseif target ~= nil and targetB ~= nil and targetC ~= nil then
script.Parent.RandomMove.Value = true
script.Parent.Target.Value = target
script.Parent.Torso.BodyGyro.cframe = CFrame.new(script.Parent.Torso.Position, targetB.Position) * CFrame.fromEulerAnglesXYZ(0, math.pi, 0)
elseif target == nil and targetB == nil and targetC == nil then
script.Parent.RandomMove.Value = false
script.Parent.Target.Value = target
script.Parent.Torso.BodyPosition.position = defaultp
script.Parent.Torso.BodyGyro.cframe = defaultc
end
end

