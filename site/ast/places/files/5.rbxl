					<ProtectedString name="Source">function frame()
local screen=script.Parent.screen

local c = screen:GetChildren()
for i = 1,#c do
&#9;if c[i].className==&quot;Decal&quot; then c[i].Parent=nil end
end

local frame=script.Parent.frame
local pic = script.Parent.t1:FindFirstChild(&quot;speak&quot;..tostring(frame.Value)):Clone()
pic.Parent=screen
end

script.Parent.frame.Changed:connect(frame)

while true do
&#9;local frame = script.Parent.frame
&#9;if frame.Value &gt;= 35 then
&#9;&#9;frame.Value = 0
&#9;else
&#9;&#9;frame.Value = frame.Value+1
&#9;end
&#9;wait(0.15)
end
