					<string name="Name">Instructions</string>
					<ProtectedString name="Source">-- This message brick is very easy to use --

step 1 -- Make sure you are using Roblox Studio --

step 2 -- Open &quot;Properties&quot; window --

step 3 -- In the &quot;Exloper&quot; menu, click on this model NAME, not the stuff inside --

step 4 -- In the Properties menu, look for where it says Name, under Data --

step 5 -- Click where it says ~Message Here~ and change it to what you want the brick to say --

step 6 -- There is no step 6, YOUR DONE --</ProtectedString>
				</Properties>
			</Item>
