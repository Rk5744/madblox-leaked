						<string name="Name">Minutes</string>
						<ProtectedString name="Source">minutes = script.Parent.Parent.Minutes.Value
TimeCount = script.Parent

while true do
&#9;TimeCount.Text = minutes
&#9;wait(60)
&#9;minutes = minutes + 1
&#9;if minutes &gt; 59 and seconds &lt; 61 then
&#9;&#9;minutes = minutes - 60
&#9;end
&#9;
end
</ProtectedString>
