		<Item class="HopperBin" referent="RBX5026">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Sit</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=17291612</url></Content>
			</Properties>
			<Item class="Script" referent="RBX5027">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function BGs()
&#9;if game.Players.LocalPlayer.Character.Torso:findFirstChild(&quot;BodyGyro&quot;)==nil then
&#9;&#9;BG=Instance.new(&quot;BodyGyro&quot;)
&#9;&#9;BG.Parent=game.Players.LocalPlayer.Character.Torso
&#9;&#9;BG.maxTorque=Vector3.new(0,0,0)
&#9;end
end
function up()
&#9;BG.maxTorque=Vector3.new(0,0,0)
end
function Down()
&#9;if game.Players.LocalPlayer.Character.Humanoid~=nil then
&#9;&#9;game.Players.LocalPlayer.Character.Humanoid.Sit=true
&#9;&#9;BG.cframe=game.Players.LocalPlayer.Character.Torso.CFrame
&#9;&#9;BG.maxTorque=Vector3.new(1,0,1)
&#9;end
&#9;Torso=game.Players.LocalPlayer.Character:findFirstChild(&quot;Torso&quot;)
&#9;if Torso~=nil then
&#9;&#9;Torso.Friction=0
&#9;end
end


function onSelected(mouse)
&#9;BGs()
&#9;mouse.Button1Down:connect(Down)
&#9;mouse.Button1Up:connect(up)
end

script.Parent.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX5028">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Instructions</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=13224090</url></Content>
			</Properties>
			<Item class="LocalScript" referent="RBX5029">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Main</string>
					<ProtectedString name="Source">--[[ SinisterAlex ]] wait&apos;&apos;

local game&#9;&#9;= game

local prev&#9;&#9;= &quot;p&quot;&#9;&#9;&#9;&#9;&#9;&#9;
local next&#9;&#9;= &quot;n&quot;&#9;&#9;&#9;&#9;&#9;
local message&#9;&#9;= &quot;&quot;&#9;
local offset&#9;&#9;= Vector3.new(0,3000,0)&#9;&#9;&#9;
local Pictures&#9;&#9;= game.Workspace[&quot;Pictures&quot;]&#9;&#9;&#9;

local Tool&#9;&#9;&#9;= script.Parent
local Player&#9;&#9;= game.Players.LocalPlayer
local Camera&#9;&#9;= game.Workspace.CurrentCamera
local Humanoid&#9;= Player.Character.Humanoid
local Talk&#9;&#9;&#9;= Instance.new(&quot;Message&quot;)
local Display&#9;&#9;= Pictures:GetChildren()[1]:Clone()

local scroll&#9;&#9;= {}
local current&#9;&#9;= 0
local previous&#9;&#9;= 0


function Switch()
&#9;scroll[previous].Parent = nil
&#9;scroll[current].Parent = Display
end

function Selected(mouse)
&#9;Talk:Remove()
&#9;Display.Decal:Remove()
&#9;Display.Position = offset
&#9;Display.Parent = Camera
&#9;Camera.CameraSubject = Display
&#9;Camera.CameraType = &quot;Attach&quot;
&#9;mouse.KeyDown:connect(function(key)
&#9;&#9;if key == next then
&#9;&#9;&#9;previous = current
&#9;&#9;&#9;current = current + 1
&#9;&#9;&#9;if current &gt; #scroll then current = #scroll else Switch() end
&#9;&#9;elseif key == prev then
&#9;&#9;&#9;previous = current
&#9;&#9;&#9;current = current - 1
&#9;&#9;&#9;if current &lt; 0 then current = 0 else Switch() end
&#9;&#9;end
&#9;end)
&#9;Switch()
end

function Deselected()
&#9;Camera.CameraSubject = Humanoid
&#9;Camera.CameraType = &quot;Custom&quot;
&#9;Talk:Remove()
end


for _,page in pairs(Pictures:GetChildren()) do
&#9;scroll[tonumber(page.Name)] = page.Decal:Clone()
end

Talk.Text = message
Talk.Parent = Player

Humanoid.WalkSpeed = 16
Humanoid.Died:connect(Deselected)

Tool.Selected:connect(Selected)
Tool.Deselected:connect(function()
&#9;Deselected()
&#9;Humanoid.WalkSpeed = 16
end)</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX5030">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Reset</string>
