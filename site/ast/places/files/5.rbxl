			<Item class="Script" referent="RBX3040">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">bin = script.Parent

function onTouched(part)
&#9;part.BrickColor = BrickColor.new(&quot;Dark stone gray&quot;)
&#9;wait(.1)
&#9;part.Transparency = .2
&#9;wait(.1)
&#9;part.Transparency = .4
&#9;wait(.1)
&#9;part.Transparency = .6
&#9;wait(.1)
&#9;part.Transparency = .8
&#9;wait(.1)
&#9;part.Parent = nil
end

connection = bin.Touched:connect(onTouched)





</ProtectedString>
				</Properties>
			</Item>
		</Item>
