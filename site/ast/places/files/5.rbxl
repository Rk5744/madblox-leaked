					<string name="Name">Script</string>
					<ProtectedString name="Source">-- (Hat Giver Script - Loaded.)

debounce = true

function onTouched(hit)
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
&#9;&#9;debounce = false
&#9;&#9;h = Instance.new(&quot;Hat&quot;)
&#9;&#9;p = script.Parent:clone()
&#9;&#9;h.Name = &quot;Majoras Hat&quot;
&#9;&#9;p.Parent = h
&#9;&#9;p.Position = hit.Parent:findFirstChild(&quot;Head&quot;).Position
&#9;&#9;p.Name = &quot;Handle&quot; 
&#9;&#9;p.formFactor = 0
&#9;&#9;p.Size = Vector3.new(2, 0.2, 2) 
&#9;&#9;p.BottomSurface = 0 
&#9;&#9;p.TopSurface = 0 
&#9;&#9;p.Locked = true 
&#9;&#9;p.Anchored = false
&#9;&#9;h.Parent = hit.Parent
&#9;&#9;h.AttachmentPos = Vector3.new(0, -0.1, 0.5)
                h.AttachmentUp = Vector3.new(0, 0, 6)
&#9;&#9;wait(5)
&#9;&#9;debounce = true
&#9;end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
