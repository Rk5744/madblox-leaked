							<string name="Name">Spawner</string>
							<ProtectedString name="Source">bin = script.Parent
function onButton1Down(mouse)

&#9;local model = bin.Plane:clone() 
&#9;model.Parent = game.Workspace
&#9;model:MakeJoints()
&#9;model:MoveTo(mouse.hit.p)
&#9;script.Parent:remove()
end
function onSelected(mouse)
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=14385482&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)</ProtectedString>
