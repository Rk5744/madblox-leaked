				<Item class="Script" referent="RBX1576">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">--Made by SinisterAlex
function onTouched(part)

&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;) or part.Parent:findFirstChild(&quot;Zombie&quot;)

&#9;if h~=nil then

wait(0.001)
h.Health = 100
children = h.Parent:children()
part.Parent:findFirstChild(&quot;Head&quot;).BrickColor = BrickColor.new(&quot;Brown&quot;)
part.Parent:findFirstChild(&quot;Torso&quot;).BrickColor = BrickColor.new(&quot;Brown&quot;)
part.Parent:findFirstChild(&quot;Left Arm&quot;).BrickColor = BrickColor.new(&quot;Brown&quot;)
part.Parent:findFirstChild(&quot;Right Arm&quot;).BrickColor = BrickColor.new(&quot;Brown&quot;)
part.Parent:findFirstChild(&quot;Left Leg&quot;).BrickColor = BrickColor.new(&quot;Brown&quot;) 
part.Parent:findFirstChild(&quot;Right Leg&quot;).BrickColor = BrickColor.new(&quot;Brown&quot;)

part.Parent:findFirstChild(&quot;Head&quot;).Material = &quot;Wood&quot;
part.Parent:findFirstChild(&quot;Torso&quot;).Material = &quot;Wood&quot;
part.Parent:findFirstChild(&quot;Left Arm&quot;).Material = &quot;Wood&quot;
part.Parent:findFirstChild(&quot;Right Arm&quot;).Material = &quot;Wood&quot;
part.Parent:findFirstChild(&quot;Left Leg&quot;).Material = &quot;Wood&quot;
part.Parent:findFirstChild(&quot;Right Leg&quot;).Material = &quot;Wood&quot;

wait(1)


&#9;for i=1,#children do

&#9;&#9;if(children[i].className == &quot;Part&quot; and children[i].Name ~= &quot;Torso&quot;) then stick(children[i], h.Parent.Torso) end

&#9;&#9;if(children[i].className == &quot;Hat&quot;) then stick(children[i].Handle, h.Parent.Torso) end

&#9;end

&#9;end


end



script.Parent.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
