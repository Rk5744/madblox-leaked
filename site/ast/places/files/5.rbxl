function onButton1Up(mouse)
sel = false
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown) 
e = script.Parent.Parent.Parent:GetChildren()
for i=1,#e do
if e[i].className == &quot;Hint&quot; then
e[i]:remove()
end
end
s = Instance.new(&quot;Hint&quot;)
s.Parent = script.Parent.Parent.Parent
s.Text = &quot;Aim Up to go UP!&quot;
Wait = 4
s.Text = &quot;Aim Upwards to tilt the path,to go higher!&quot;
end

function unsel(mouse)
e = script.Parent.Parent.Parent:GetChildren()
for i=1,#e do
if e[i].className == &quot;Hint&quot; then
e[i]:remove()
end
end
end


script.Parent.Selected:connect(onEquippedLocal) 
script.Parent.Deselected:connect(unsel)</ProtectedString>
