					<ProtectedString name="Source">print(&quot;SinisterAlex Message&quot;)--Made by SinisterAlex&lt;----Delete this if you want!

local debounce = false


function onHit(hit)
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Parent = game.Players:playerFromCharacter(hit.Parent)
message.Text = &quot;If you made a good game it will be here for free!&quot; ------Change the Text to something you want in  between the &quot;Message&quot;
wait(5)
message:Remove ()

                debounce = false
&#9;end
end

script.Parent.Touched:connect(onHit)








