&#9;model:MakeJoints()
&#9;model:MoveTo(mouse.hit.p)
&#9;script.Parent:remove()
end
function onSelected(mouse)
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=14385482&quot;
