part.Parent:findFirstChild(&quot;Torso&quot;).Material = &quot;Slate&quot;
part.Parent:findFirstChild(&quot;Left Arm&quot;).Material = &quot;Slate&quot;
part.Parent:findFirstChild(&quot;Right Arm&quot;).Material = &quot;Slate&quot;
