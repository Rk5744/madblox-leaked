					<Item class="Script" referent="RBX10">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Tick</string>
							<ProtectedString name="Source">while true do
&#9;wait()
&#9;local seconds = math.floor(workspace.DistributedGameTime)
&#9;local minutes = math.floor(workspace.DistributedGameTime / 60)
&#9;local hours = math.floor(workspace.DistributedGameTime / 60 / 60)
&#9;local seconds = seconds - (minutes * 60)
&#9;local minutes = minutes - (hours * 60)
&#9;if hours &lt; 1 then
&#9;&#9;if minutes &lt; 1 then
&#9;&#9;&#9;script.Parent.Text = seconds .. &quot; Seconds&quot;
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Text = minutes .. &quot; Minutes, &quot; .. seconds .. &quot; Seconds&quot;
&#9;&#9;end
&#9;else
&#9;&#9;script.Parent.Text = hours .. &quot; Hours, &quot; .. minutes .. &quot; Minutes, &quot; .. seconds .. &quot; Seconds&quot;
&#9;end
end
</ProtectedString>
						</Properties>
					</Item>
				</Item>
