			<Item class="Script" referent="RBX1866">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MessageBox</string>
					<ProtectedString name="Source">print(&quot;Mattcena&apos;s message box&quot;)

local debounce = false


function onHit(hit)
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Parent = game.Players:playerFromCharacter(hit.Parent)
message.Text = &quot;You will get something cool soon!&quot; 
wait(5)

message:Remove ()

                debounce = false
&#9;end
end

script.Parent.Touched:connect(onHit)





</ProtectedString>
				</Properties>
			</Item>
